{
  "id": null,
  "uid": "conduit-overview",
  "title": "Conduit API Overview",
  "tags": ["conduit", "api", "overview"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "type": "stat",
      "title": "Total Requests (24h)",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(increase(conduit_usage_tracking_requests_total[24h]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 10000},
              {"color": "red", "value": 50000}
            ]
          },
          "unit": "short"
        }
      }
    },
    {
      "id": 2,
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "type": "stat",
      "title": "Total Cost Today ($)",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(increase(conduit_usage_tracking_cost_dollars[24h]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 100},
              {"color": "red", "value": 500}
            ]
          },
          "unit": "currencyUSD",
          "decimals": 2
        }
      }
    },
    {
      "id": 3,
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "type": "stat",
      "title": "Active Virtual Keys",
      "targets": [
        {
          "datasource": "PostgreSQL",
          "rawSql": "SELECT COUNT(DISTINCT \"VirtualKeyId\") FROM \"RequestLogs\" WHERE \"Timestamp\" > NOW() - INTERVAL '24 hours'",
          "refId": "A",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null}
            ]
          },
          "unit": "short"
        }
      }
    },
    {
      "id": 4,
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "type": "stat",
      "title": "Error Rate",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(conduit_usage_tracking_failures_total[5m])) / sum(rate(conduit_usage_tracking_requests_total[5m])) * 100",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 1},
              {"color": "red", "value": 5}
            ]
          },
          "unit": "percent",
          "decimals": 2
        }
      }
    },
    {
      "id": 5,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "type": "timeseries",
      "title": "Request Rate",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(conduit_usage_tracking_requests_total[5m])) by (endpoint_type)",
          "legendFormat": "{{endpoint_type}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": {
              "tooltip": false,
              "viz": false,
              "legend": false
            },
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": {"type": "linear"},
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {"group": "A", "mode": "none"},
            "thresholdsStyle": {"mode": "off"}
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null}
            ]
          },
          "unit": "reqps"
        }
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 6,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "type": "timeseries",
      "title": "Token Usage",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(conduit_usage_tracking_tokens_total[5m])) by (token_type)",
          "legendFormat": "{{token_type}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": {
              "tooltip": false,
              "viz": false,
              "legend": false
            },
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": {"type": "linear"},
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {"group": "A", "mode": "normal"},
            "thresholdsStyle": {"mode": "off"}
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null}
            ]
          },
          "unit": "short"
        }
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 7,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "type": "piechart",
      "title": "Cost by Model",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(increase(conduit_usage_tracking_cost_dollars[24h])) by (model)",
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        },
        "pieType": "donut",
        "displayLabels": ["name", "percent"],
        "legendDisplayMode": "list",
        "legendPlacement": "right",
        "legendShowLegend": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2
        }
      }
    },
    {
      "id": 8,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "type": "table",
      "title": "Top Virtual Keys by Usage",
      "targets": [
        {
          "datasource": "PostgreSQL",
          "rawSql": "SELECT \n  vk.\"Name\" as \"Key Name\",\n  COUNT(rl.\"Id\") as \"Requests\",\n  SUM(rl.\"Cost\") as \"Total Cost\",\n  SUM(rl.\"InputTokens\" + rl.\"OutputTokens\") as \"Total Tokens\",\n  MAX(rl.\"Timestamp\") as \"Last Used\"\nFROM \"RequestLogs\" rl\nJOIN \"VirtualKeys\" vk ON rl.\"VirtualKeyId\" = vk.\"Id\"\nWHERE rl.\"Timestamp\" > NOW() - INTERVAL '24 hours'\nGROUP BY vk.\"Name\"\nORDER BY SUM(rl.\"Cost\") DESC\nLIMIT 10",
          "refId": "A",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": false,
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Total Cost"},
            "properties": [
              {"id": "unit", "value": "currencyUSD"},
              {"id": "decimals", "value": 2}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Last Used"},
            "properties": [
              {"id": "unit", "value": "dateTimeFromNow"}
            ]
          }
        ]
      }
    }
  ]
}