{
  "id": null,
  "uid": "conduit-request-pipeline",
  "title": "Request Pipeline",
  "tags": ["conduit", "http", "requests", "latency"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "endpoint",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "query": "label_values(conduit_http_requests_total, endpoint)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "method",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "query": "label_values(conduit_http_requests_total, method)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "type": "stat",
      "title": "Requests/sec",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(rate(conduit_http_requests_total{endpoint=~\"$endpoint\", method=~\"$method\"}[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null}
            ]
          },
          "unit": "reqps",
          "decimals": 2
        }
      }
    },
    {
      "id": 2,
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0},
      "type": "stat",
      "title": "Active Requests",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(conduit_http_requests_active{endpoint=~\"$endpoint\", method=~\"$method\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 100},
              {"color": "red", "value": 500}
            ]
          },
          "unit": "short",
          "noValue": "0"
        }
      }
    },
    {
      "id": 3,
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0},
      "type": "stat",
      "title": "P50 Latency",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "histogram_quantile(0.50, sum(rate(conduit_http_request_duration_seconds_bucket{endpoint=~\"$endpoint\", method=~\"$method\"}[5m])) by (le))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 1},
              {"color": "red", "value": 3}
            ]
          },
          "unit": "s",
          "decimals": 3
        }
      }
    },
    {
      "id": 4,
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0},
      "type": "stat",
      "title": "P99 Latency",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "histogram_quantile(0.99, sum(rate(conduit_http_request_duration_seconds_bucket{endpoint=~\"$endpoint\", method=~\"$method\"}[5m])) by (le))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 5},
              {"color": "red", "value": 10}
            ]
          },
          "unit": "s",
          "decimals": 3
        }
      }
    },
    {
      "id": 5,
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 0},
      "type": "stat",
      "title": "Error Rate",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "(sum(rate(conduit_http_requests_total{endpoint=~\"$endpoint\", method=~\"$method\", status_code=~\"5..\"}[5m])) / sum(rate(conduit_http_requests_total{endpoint=~\"$endpoint\", method=~\"$method\"}[5m]))) * 100",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 1},
              {"color": "red", "value": 5}
            ]
          },
          "unit": "percent",
          "decimals": 2,
          "noValue": "0%"
        }
      }
    },
    {
      "id": 6,
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 0},
      "type": "stat",
      "title": "Rate Limit Hits",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(increase(conduit_rate_limit_exceeded_total{endpoint=~\"$endpoint\"}[1h]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 10},
              {"color": "red", "value": 100}
            ]
          },
          "unit": "short",
          "noValue": "0"
        }
      }
    },
    {
      "id": 7,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "type": "timeseries",
      "title": "Request Rate by Endpoint",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(rate(conduit_http_requests_total{endpoint=~\"$endpoint\", method=~\"$method\"}[5m])) by (endpoint)",
          "legendFormat": "{{endpoint}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "stacking": {"mode": "none"}
          },
          "unit": "reqps"
        }
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },
    {
      "id": 8,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "type": "timeseries",
      "title": "Latency Distribution",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "histogram_quantile(0.50, sum(rate(conduit_http_request_duration_seconds_bucket{endpoint=~\"$endpoint\", method=~\"$method\"}[5m])) by (le))",
          "legendFormat": "P50",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "histogram_quantile(0.90, sum(rate(conduit_http_request_duration_seconds_bucket{endpoint=~\"$endpoint\", method=~\"$method\"}[5m])) by (le))",
          "legendFormat": "P90",
          "refId": "B"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "histogram_quantile(0.95, sum(rate(conduit_http_request_duration_seconds_bucket{endpoint=~\"$endpoint\", method=~\"$method\"}[5m])) by (le))",
          "legendFormat": "P95",
          "refId": "C"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "histogram_quantile(0.99, sum(rate(conduit_http_request_duration_seconds_bucket{endpoint=~\"$endpoint\", method=~\"$method\"}[5m])) by (le))",
          "legendFormat": "P99",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "s"
        }
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },
    {
      "id": 9,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "type": "timeseries",
      "title": "Response Status Codes",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(rate(conduit_http_requests_total{endpoint=~\"$endpoint\", method=~\"$method\", status_code=~\"2..\"}[5m]))",
          "legendFormat": "2xx Success",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(rate(conduit_http_requests_total{endpoint=~\"$endpoint\", method=~\"$method\", status_code=~\"4..\"}[5m]))",
          "legendFormat": "4xx Client Error",
          "refId": "B"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(rate(conduit_http_requests_total{endpoint=~\"$endpoint\", method=~\"$method\", status_code=~\"5..\"}[5m]))",
          "legendFormat": "5xx Server Error",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 2,
            "showPoints": "never",
            "stacking": {"mode": "normal"}
          },
          "unit": "reqps"
        },
        "overrides": [
          {"matcher": {"id": "byName", "options": "2xx Success"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}}]},
          {"matcher": {"id": "byName", "options": "4xx Client Error"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "yellow"}}]},
          {"matcher": {"id": "byName", "options": "5xx Server Error"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]}
        ]
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },
    {
      "id": 10,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "type": "timeseries",
      "title": "Request/Response Size",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "histogram_quantile(0.50, sum(rate(conduit_http_request_size_bytes_bucket{endpoint=~\"$endpoint\", method=~\"$method\"}[5m])) by (le))",
          "legendFormat": "Request Size P50",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "histogram_quantile(0.50, sum(rate(conduit_http_response_size_bytes_bucket{endpoint=~\"$endpoint\", method=~\"$method\"}[5m])) by (le))",
          "legendFormat": "Response Size P50",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "bytes"
        }
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },
    {
      "id": 11,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
      "type": "timeseries",
      "title": "Rate Limiting Events",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(rate(conduit_rate_limit_exceeded_total{endpoint=~\"$endpoint\"}[5m])) by (endpoint)",
          "legendFormat": "{{endpoint}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "unit": "short"
        }
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },
    {
      "id": 12,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
      "type": "heatmap",
      "title": "Latency Heatmap",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(increase(conduit_http_request_duration_seconds_bucket{endpoint=~\"$endpoint\", method=~\"$method\"}[1m])) by (le)",
          "format": "heatmap",
          "legendFormat": "{{le}}",
          "refId": "A"
        }
      ],
      "options": {
        "calculate": false,
        "yAxis": {"unit": "s"},
        "cellGap": 1,
        "color": {
          "mode": "scheme",
          "scheme": "Spectral",
          "reverse": true
        },
        "tooltip": {"show": true, "yHistogram": true}
      }
    }
  ]
}
