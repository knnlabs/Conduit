    {
      "id": 20,
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 26},
      "type": "stat",
      "title": "Cache Hit Ratio",
      "targets": [
        {
          "datasource": {"type": "postgres", "uid": "postgresql"},
          "rawSql": "SELECT ROUND(100.0 * sum(blks_hit) / nullif(sum(blks_hit) + sum(blks_read), 0), 2) FROM pg_stat_database WHERE datname = 'conduitdb'",
          "refId": "A",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 90},
              {"color": "green", "value": 98}
            ]
          },
          "unit": "percent",
          "decimals": 2
        }
      }
    },
    {
      "id": 21,
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 30},
      "type": "table",
      "title": "Table Sizes",
      "targets": [
        {
          "datasource": {"type": "postgres", "uid": "postgresql"},
          "rawSql": "SELECT \n  relname as \"Table\",\n  pg_size_pretty(pg_total_relation_size(relid)) as \"Total Size\",\n  pg_size_pretty(pg_relation_size(relid)) as \"Data Size\",\n  pg_size_pretty(pg_indexes_size(relid)) as \"Index Size\",\n  n_live_tup as \"Row Count\"\nFROM pg_stat_user_tables\nORDER BY pg_total_relation_size(relid) DESC\nLIMIT 15",
          "refId": "A",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {"align": "auto", "filterable": true}
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Row Count"},
            "properties": [{"id": "unit", "value": "locale"}]
          }
        ]
      }
    },
