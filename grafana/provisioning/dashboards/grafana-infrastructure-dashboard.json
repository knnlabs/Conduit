    {
      "id": 1,
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 2},
      "type": "stat",
      "title": "Redis Uptime",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "redis_uptime_in_seconds",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 3600},
              {"color": "green", "value": 86400}
            ]
          },
          "unit": "s"
        }
      }
    },
