          "datasource": {"type": "postgres", "uid": "postgresql"},
          "rawSql": "SELECT pg_database_size('conduitdb')",
          "refId": "A",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
