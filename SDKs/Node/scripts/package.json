{
  "name": "@conduit/codegen-scripts",
  "version": "1.0.0",
  "private": true,
  "description": "Code generation scripts for Conduit SDK",
  "scripts": {
    "generate": "npm run generate:admin && npm run generate:gateway",
    "generate:admin": "openapi-typescript http://localhost:5001/swagger/v1/swagger.json -o ../Admin/src/generated/admin-api.ts",
    "generate:gateway": "openapi-typescript http://localhost:5000/swagger/v1/swagger.json -o ../Gateway/src/generated/gateway-api.ts",
    "generate:from-files": "npm run generate:gateway:file && npm run generate:admin:file",
    "generate:admin:file": "openapi-typescript ../../../ConduitLLM.Admin/openapi-admin.json -o ../Admin/src/generated/admin-api.ts",
    "generate:gateway:file": "openapi-typescript ../../../Services/ConduitLLM.Gateway/openapi-gateway.json -o ../Gateway/src/generated/gateway-api.ts",
    "generate:docker": "npm run generate:admin:docker && npm run generate:gateway:docker",
    "generate:admin:docker": "openapi-typescript ${ADMIN_API_URL}/swagger/v1/swagger.json -o ../Admin/src/generated/admin-api.ts",
    "generate:gateway:docker": "openapi-typescript ${GATEWAY_API_URL}/swagger/v1/swagger.json -o ../Gateway/src/generated/gateway-api.ts",
    "postgenerate": "npm run format",
    "format": "prettier --write ../*/src/generated/*.ts",
    "clean": "rm -rf ../*/src/generated"
  },
  "devDependencies": {
    "openapi-typescript": "^7.4.4",
    "prettier": "^3.0.0"
  }
}